# JobRadar Environment Variables
# Copy this file to .env.local for local development

# Note: API credentials are stored in browser localStorage by default
# These environment variables are optional and only needed for server-side configuration

# Optional: Default API configuration (not recommended for production)
# NEXT_PUBLIC_DEFAULT_API_KEY=your_google_api_key_here
# NEXT_PUBLIC_DEFAULT_CX_ID=your_search_engine_id_here

# Optional: Analytics
# NEXT_PUBLIC_GA_ID=your_google_analytics_id

# Optional: Sentry Error Tracking
# NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn
# SENTRY_AUTH_TOKEN=your_sentry_auth_token

# Optional: Environment
# NODE_ENV=development
